# Sao chép thành .env rồi chỉnh giá trị
POSTGRES_PASSWORD=nihongo
# Bắt buộc, tối thiểu 32 ký tự
JWT_SECRET=change-me-to-a-long-random-string-32chars
# Tuỳ chọn: AI tạo đề & chấm điểm qua ModelAPI (tương thích OpenAI) – lấy key tại modelapi.vn
AI_API_KEY=
AI_BASE_URL=https://modelapi.vn/v1
AI_MODEL=gpt-6.1-sol
AI_FALLBACK_MODEL=
# URL công khai (CORS) và cổng nginx
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
# true khi chạy sau HTTPS
COOKIE_SECURE=false
# Seed dữ liệu mẫu khi DB trống
SEED_ON_EMPTY=true
